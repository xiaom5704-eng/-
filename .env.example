# Optional, local development only: VITE_ variables are embedded in browser code.
# Leave empty on shared deployments; users can enter their own key in the UI.
VITE_GEMINI_API_KEY=""
# Shared by key validation, text and image/PDF extraction. Rebuild after changing.
VITE_GEMINI_MODEL="gemini-3-flash-preview"

# Optional server-only openFDA key. Never prefix this with VITE_.
OPENFDA_API_KEY=""

# Official downloaded datasets and a separate conversation database.
DRUG_DB_PATH="data/drugs.db"
# Downloaded vision model, reference images and image index (no API key).
VISION_DATA_DIR="data/vision"
CHAT_DB_PATH="medsafe.db"
PORT=3000
# Set 127.0.0.1 to accept connections only from this computer.
HOST=0.0.0.0

# In Docker use http://ollama-service:11434.
OLLAMA_API_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
# Optional pill appearance assistance needs an installed vision-capable model
# (for example qwen3.5:4b). CV/OCR and the age demo work without Ollama.
# Photos are accepted only by a local endpoint/model; remote/cloud models are refused.
# Allow slower CPU inference to finish (milliseconds).
OLLAMA_TIMEOUT_MS=300000
# Optional for supported thinking models (for example Qwen 3.5) on local machines.
# OLLAMA_THINK=false
# OLLAMA_CONTEXT_SIZE=4096
