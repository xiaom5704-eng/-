{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data:install": "tsx scripts/setup-local-data.mjs",
    "data:apply-reviewed": "tsx scripts/apply-reviewed-ddinter.ts",
    "data:import-labels": "tsx scripts/import-tfda-labels.ts",
    "vision:prepare": "node scripts/prepare-vision.mjs",
    "vision:index": "tsx scripts/index-vision.mjs",
    "vision:originals": "tsx scripts/fetch-vision-originals.ts",
    "vision:import-package": "tsx scripts/import-package.ts",
    "vision:check-package": "tsx scripts/check-package.ts",
    "vision:check": "tsx scripts/check-vision.ts",
    "ocr:prepare": "node scripts/prepare-ocr.mjs",
    "icons:prepare": "node scripts/prepare-icons.mjs",
    "predev": "npm run icons:prepare && npm run ocr:prepare",
    "prebuild": "npm run icons:prepare && npm run ocr:prepare",
    "data:sync": "tsx scripts/sync-drug-data.ts",
    "data:enrich": "tsx scripts/enrich-ingredients.ts",
    "data:enrich-ddinter": "tsx scripts/enrich-ddinter-names.ts",
    "data:enrich-ddinter-web": "tsx scripts/enrich-ddinter-web.ts",
    "data:enrich-ddinter-details": "tsx scripts/enrich-ddinter-details.ts",
    "data:cache-documents": "tsx scripts/cache-source-documents.ts",
    "data:check-search": "tsx scripts/check-local-search.ts",
    "data:check-labels": "tsx scripts/check-labels.ts",
    "runtime:check": "node scripts/check-runtime.mjs",
    "data:import-appearance": "tsx scripts/import-drug-appearance.ts",
    "test": "tsx --test tests/*.test.ts",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.js",
    "preelectron:dev": "npm run icons:prepare && npm run ocr:prepare",
    "electron:dev": "node scripts/desktop-dev.mjs",
    "electron:build": "node scripts/package-desktop.mjs",
    "electron:check": "node scripts/check-desktop.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "start": "node dist-server/server.js",
    "electron:setup": "npm ci --prefix electron"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@huggingface/transformers": "3.8.1",
    "@napi-rs/canvas": "0.1.100",
    "@paddleocr/paddleocr-js": "0.4.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.4.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "opencc-js": "1.4.2",
    "parse5": "8.0.1",
    "pdfjs-dist": "5.4.624",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "0.35.4",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "@paddleocr/paddleocr-js": {
      "onnxruntime-web": "1.24.3"
    },
    "@huggingface/transformers": {
      "sharp": "$sharp"
    },
    "qs": "6.16.0"
  }
}
